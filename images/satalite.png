net Saturn\\\"\\n             class=\\\"real-saturn-image\\\"\u003e\\n    \u003c/a\u003e\\n\\n    \u003cp class=\\\"saturn-label\\\"\u003ePLANET 06 / SATURN\u003c/p\u003e\\n\u003c/div\u003e\\n\u003c/CodeBlock\u003e\\n\\n## ২. CSS code\\n\\nতোমার `style.css`-এর একদম শেষে যোগ করো:\\n\\n\u003cCodeBlock language=\\\"css\\\" editable\u003e\\n/* Real Saturn beside other planets */\\n#Solar-system .saturn-area {\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    text-align: center;\\n}\\n\\n#Solar-system .real-saturn-image {\\n    width: 130px;\\n    height: 100px;\\n    object-fit: contain;\\n    display: block;\\n    filter: drop-shadow(0 0 14px rgba(220, 190, 130, 0.6));\\n    transition: transform 0.3s ease;\\n}\\n\\n#Solar-system .real-saturn-image:hover {\\n    transform: scale(1.12);\\n}\\n\\n#Solar-system .saturn-label {\\n    margin-top: 12px;\\n    color: #e9d09a;\\n    font-size: 12px;\\n    letter-spacing: 1.5px;\\n}\\n\u003c/CodeBlock\u003e\\n\\n## ৩. Saturn-এর ছবিটি রাখো\\n\\nতোমার Saturn-এর real ছবি `images` folder-এ রাখো এবং নাম দাও `saturn.png`। অন্য নাম হলে HTML-এর `src`-এ সেই নাম বসাবে।\\n\\nতারপর `Ctrl + S` দিয়ে save করে browser-এ `Ctrl + F5` চাপো।\\n\\n**মনে রেখো:** Saturn-এর ছবিতে ring-সহ পুরো গ্রহ দেখা যাবে। যদি Saturn, Earth ও Mars-এর পাশে না এসে নিচে চলে যায়, তাহলে `.solar-system`-এর CSS-টাও ঠিক করতে হবে।\",{},{\"_482\":495,\"_484\":-5,\"_97\":825},1792240827.013,1792240835.513205,{\"_477\":478,\"_479\":823},{\"_124\":750,\"_492\":-5,\"_128\":751,\"_130\":751,\"_134\":34},[824],\"do same for saturn\",{}]\n");</script><!--$?--><template id="B:1"></template><!--/$--></div><script nonce="8d3492bd-4353-49f3-861f-5bbd0fe4c55f">$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"