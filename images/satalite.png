   filter: drop-shadow(0 0 12px rgba(200, 210, 255, 0.5));\\n    transition: transform 0.3s ease;\\n}\\n\\n.corner-moon img:hover {\\n    transform: scale(1.15);\\n}\\n```\\n\\n## ৩\\\\. নিজের মতো position ঠিক করো\\n\\n- `top: 100px;` — ওপর থেকে কতটা নিচে থাকবে।\\n- `right: 25px;` — ডান পাশ থেকে দূরত্ব।\\n- `width: 75px; height: 75px;` — চাঁদের আকার।\\n\\nচাঁদকে একেবারে ওপরের ডান কোণায় রাখতে `top: 20px;` করে দাও।\\n\\n**মনে রেখো\\\\:** `images` folder-এ তোমার চাঁদের ছবিটি `moon.png` নামে রাখবে, অথবা HTML-এ ছবির আসল নাম লিখবে।\",{\"_688\":689,\"_690\":691},{\"_234\":685},{\"_236\":686,\"_238\":239,\"_240\":687},{},{},\"a9d94776-ceb9-52d6-9994-6268fec003be\",{\"_14\":243,\"_369\":371,\"_370\":34},\"d350efc8-672d-5926-9ec9-4af350fe5bfd\",{\"_14\":243,\"_369\":96,\"_370\":34},\"কাব্বো 🌙 তুমি একটা ছোট চাঁদ একেবারে ডান পাশের কোণায় রাখতে চাও। এটা শুধু CSS দিয়েই করা যাবে, তোমার website-এর অন্য design পরিবর্তন করতে হবে না।\",\"১. HTML-এ এই code যোগ করো\",\"-এর ঠিক আগে বসাও। তোমার চাঁদের ছবির নাম \",\" হলে এভাবে লিখবে।\",\"২. \",\"-এর একদম শেষে এই CSS বসাও\",\"৩. নিজের মতো position ঠিক করো\",\"top: 100px;\",\" — ওপর থেকে কতটা নিচে থাকবে।\",\"right: 25px;\",\" — ডান পাশ থেকে দূরত্ব।\",\"width: 75px; height: 75px;\",\" — চাঁদের আকার।\",\"চাঁদকে একেবারে ওপরের ডান কোণায় রাখতে \",\"top: 20px;\",\" \",\" folder-এ তোমার চাঁদের ছবিটি \",\" নামে রাখবে, অথবা HTML-এ ছবির আসল নাম লিখবে।\",{\"_170\":448,\"_449\":210,\"_450\":719,\"_443\":627,\"_445\":720,\"_446\":721,\"_36\":722,\"_456\":723,\"_458\":-5,\"_459\":-5},{\"_170\":448,\"_449\":210,\"_450\":712,\"_443\":713,\"_445\":714,\"_446\":715,\"_36\":716,\"_456\":717,\"_458\":-5,\"_459\":-5},{\"_91\":718,\"_461\":462,\"_463\":72,\"_464\":210},\"```css\\n\\n/* Small Moon at the Top-Right Corner */\\n.corner-moon {\\n    position: fixed;\\n    top: 100px;\\n    right: 25px;\\n    z-index: 999;\\n    width: 75px;\\n    height: 75px;\\n}\\n\\n.corner-moon img {\\n    width: 100%;\\n    height: 100%;\\n    object-fit: contain;\\n    displ